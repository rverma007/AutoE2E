# Target application
BASE_URL=https://correspondence.sprint.autonomize.dev/

# Credentials
APP_USERNAME=sapna.bhatt@autonomize.ai
APP_PASSWORD=Sapna@2025

# Browser configuration
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Artifacts
RECORD_VIDEO=false
