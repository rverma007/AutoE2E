# =============================================================
# AutoPythone2e - Environment Configuration (sample)
# Copy this file to .env and replace values as needed.
# .env is gitignored and should never be committed.
# =============================================================

# Target application
BASE_URL=https://your-app-host/

# Credentials
APP_USERNAME=your.user@example.com
APP_PASSWORD=YourPassword

# Browser configuration
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Artifacts
RECORD_VIDEO=false
RECORD_TRACE=true
SCREENSHOT_ON_FAILURE=true

# Reporting
REPORT_TITLE=AutoPythone2e Sanity Report
ENVIRONMENT=sprint
